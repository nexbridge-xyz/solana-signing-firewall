{
  "name": "@nexbridge/example-devnet-payouts",
  "version": "0.0.0",
  "private": true,
  "description": "Signing Firewall for Solana devnet demo: setup for both demos, scenes 1 to 11, the recorded run, verify-run and recycling. Scenes 12 to 15 come from examples/x402-agent.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "keys": "tsx src/cli.ts keys",
    "setup": "tsx src/cli.ts setup",
    "demo": "tsx src/cli.ts demo",
    "demo:x402": "tsx src/cli.ts demo-x402",
    "record": "tsx src/cli.ts record",
    "verify-run": "tsx src/cli.ts verify-run",
    "recycle": "tsx src/cli.ts recycle",
    "rehearse": "tsx src/cli.ts rehearse",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@nexbridge/example-demo-common": "workspace:*",
    "@nexbridge/example-x402-agent": "workspace:*",
    "@nexbridge/solana-signing-firewall": "workspace:*",
    "@solana-program/address-lookup-table": "0.16.0",
    "@solana-program/compute-budget": "0.20.0",
    "@solana-program/system": "0.16.0",
    "@solana-program/token": "0.18.0",
    "@solana/kit": "8.6.0"
  },
  "devDependencies": {
    "@nexbridge/solana-signing-firewall-fixtures": "workspace:*",
    "litesvm": "1.6.2"
  }
}
