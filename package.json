{
  "name": "solana-signing-firewall-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Signing Firewall for Solana: checks a Solana transaction before your signer signs it.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --no-bail run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "fixtures": "pnpm --filter @nexbridge/solana-signing-firewall-fixtures run fixtures",
    "fixtures:generate": "pnpm --filter @nexbridge/solana-signing-firewall-fixtures run generate",
    "fixtures:check": "pnpm --filter @nexbridge/solana-signing-firewall-fixtures run check",
    "demo:keys": "pnpm --filter @nexbridge/example-devnet-payouts run keys",
    "demo:setup": "pnpm --filter @nexbridge/example-devnet-payouts run setup",
    "demo": "pnpm --filter @nexbridge/example-devnet-payouts run demo",
    "demo:x402": "pnpm --filter @nexbridge/example-devnet-payouts run demo:x402",
    "demo:record": "pnpm --filter @nexbridge/example-devnet-payouts run record",
    "verify-run": "pnpm --filter @nexbridge/example-devnet-payouts run verify-run",
    "demo:recycle": "pnpm --filter @nexbridge/example-devnet-payouts run recycle",
    "demo:rehearse": "pnpm --filter @nexbridge/example-devnet-payouts run rehearse",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
