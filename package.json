{
  "name": "solana-signing-firewall-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Signing Firewall for Solana: checks a Solana transaction before your signer signs it.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --no-bail run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "fixtures": "pnpm --filter @nexbridge/solana-signing-firewall-fixtures run fixtures",
    "fixtures:generate": "pnpm --filter @nexbridge/solana-signing-firewall-fixtures run generate",
    "fixtures:check": "pnpm --filter @nexbridge/solana-signing-firewall-fixtures run check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "fast-check": "4.10.2",
    "prettier": "3.10.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vitest": "5.1.0"
  }
}
